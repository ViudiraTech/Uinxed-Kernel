# Uinxed CLI boot profile.
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# BusyBox init creates a session before opening tty1, so Bash inherits the
# controlling terminal and foreground process group needed for job control.
tty1::respawn:/bin/bash

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
