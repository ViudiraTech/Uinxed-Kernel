# Uinxed CLI boot profile.
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# Drop straight into a root shell on the first virtual console.  setsid makes
# bash a session/process-group leader so interactive job control works.
tty1::respawn:/bin/busybox setsid /bin/bash

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
