        range 9600 115200
        help
          Default baud rate used by the RS-232 serial port driver.

      config SERIAL_DATA_BITS
        int "Serial port data bits"
        depends on SERIAL
        default 8
        range 5 8
        help
          Number of data bits per character for the serial port device.

      config SERIAL_STOP_BITS
        int "Serial port stop bits"
        depends on SERIAL
        default 1
        range 1 2
        help
          Number of stop bits per character for the serial port device.

      config SERIAL_PARITY
        int "Serial port parity"
        depends on SERIAL
        default 0
        range 0 2
        help
          Parity mode: 0 = none, 1 = odd, 2 = even. Applied to the
          line-control register along with CONFIG_SERIAL_DATA_BITS and
          CONFIG_SERIAL_STOP_BITS.

      config UART_RX_BUF_SIZE
        int "Serial receive buffer size (bytes)"
        depends on SERIAL
        default 256
        range 64 65536
        help
          Size of the per-port serial receive ring buffer.

      config UART_TX_BUF_SIZE
        int "Serial transmit buffer size (bytes)"
        depends on SERIAL
        default 8192
        range 128 131072
        help
          Size of the per-port serial transmit ring buffer.
    endmenu

