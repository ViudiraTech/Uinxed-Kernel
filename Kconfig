menu "File systems"
  menu "Virtual filesystem"
    config VFS_PATH_MAX
      int "Maximum path length (bytes)"
      default 4096
      range 256 65536
      help
        Maximum length of a canonical path accepted by the VFS.

    config VFS_DCACHE_BUCKETS
      int "VFS dentry cache hash buckets"
      default 1024
      range 64 4096
      help
        Number of hash buckets in the VFS dentry cache.  The bucket index is
        derived by masking the hash with this value minus one, so it must be
        a power of two.

    config VFS_DCACHE_MAX_NEGATIVE
      int "Maximum negative dentries cached"
      default 4096
      range 64 65536
      help
        Maximum number of negative (failed-lookup) dentries kept in the dcache.

    config VFS_ICACHE_BUCKETS
      int "VFS inode cache hash buckets"
      default 512
      range 32 2048
      help
        Number of hash buckets in the VFS inode cache.  The bucket index is
        derived by masking the hash with this value minus one, so it must be
        a power of two.

    config VFS_ICACHE_MAX_UNUSED
      int "Maximum unused inodes cached"
      default 4096
      range 64 65536
      help
        Maximum number of unused inodes kept in the icache.

    config PAGECACHE_HASH_MAX_BITS
      int "Page cache hash maximum bits"
      default 12
      range 6 20
      help
        Highest bucket count shift the page cache hash may grow to.

    config PAGECACHE_READAHEAD_MAX
      int "Page cache readahead window"
      default 16
      range 1 256
      help
        Largest readahead window issued for one file mapping, in pages.

    config PAGECACHE_RECLAIM_MAX_WRITEBACK
      int "Page cache reclaim writeback batch"
      default 4
      range 1 64
      help
        Pages written back in one reclaim step.
  endmenu

